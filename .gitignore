# =========================================================
# Python
# =========================================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg
*.egg-info/
dist/
build/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/


# =========================================================
# Environment & Secrets
# =========================================================

.env
.env.*
!.env.example

# API keys / credentials
*.pem
*.key
secrets/
credentials/


# =========================================================
# Jupyter
# =========================================================

.ipynb_checkpoints/


# =========================================================
# Data
# =========================================================

# Raw NASA datasets can be huge
data/raw/*
!data/raw/.gitkeep

# Intermediate processing files
data/interim/*
!data/interim/.gitkeep

# Processed data. Everything is ignored except the files the backend serves at
# runtime (see the allow-list below the "Large scientific / binary files" block).
data/processed/*
!data/processed/.gitkeep

# Task 1 MEDA pipeline output (--out-dir): weather_intensity.parquet,
# observations.parquet, manifest.json, qa_report.*, variables.json
data/resources/MEDA_Weather_ds/processed/

# Keep only small sample/demo data
!data/sample/
!data/sample/**

# Large geospatial files
*.tif
*.tiff
*.img
*.jp2
*.vrt
*.hdf
*.h5
*.nc

# Large scientific / binary files
*.bin
*.dat
*.zip
*.tar
*.gz


# =========================================================
# Runtime data served by the backend (deployed with the repo)
# Must stay AFTER the *.tif / *.img rules above: the last matching rule wins.
# =========================================================
!data/processed/jezero/
data/processed/jezero/*
!data/processed/jezero/jezero_aoi_boundary.geojson
!data/processed/jezero/map_metadata.json
!data/processed/jezero/tiles/
!data/processed/jezero/tiles/**
!data/processed/jezero/terrain/
data/processed/jezero/terrain/*
!data/processed/jezero/terrain/jezero_aoi_ctx_dem_20m.tif
!data/processed/jezero/terrain/ctx_texture.png
!data/processed/jezero/science/
data/processed/jezero/science/*
!data/processed/jezero/science/crism/
data/processed/jezero/science/crism/*
!data/processed/jezero/science/crism/crism_aoi_20m.tif
!data/processed/jezero/science/crism/crism_dual_band_overlay.png
!data/processed/jezero/science/crism/metadata.json


# =========================================================
# MEDA Weather runtime data
# =========================================================

!data/processed/resources/
data/processed/resources/*

!data/processed/resources/MEDA_Weather_ds/
data/processed/resources/MEDA_Weather_ds/*

!data/processed/resources/MEDA_Weather_ds/processed/
data/processed/resources/MEDA_Weather_ds/processed/*

!data/processed/resources/MEDA_Weather_ds/processed/weather_intensity.parquet
!data/processed/resources/MEDA_Weather_ds/processed/manifest.json



# =========================================================
# Frontend
# =========================================================

node_modules/
dist/
build/
.vite/
*.local

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# =========================================================
# React / Frontend environment
# =========================================================

frontend/.env
frontend/.env.*
!frontend/.env.example


# =========================================================
# 3D Assets
# =========================================================

# Large generated 3D files
*.glb
*.gltf

# Allow small demo 3D models for Frontend rendering & samples
!frontend/public/assets/*.glb
!frontend/public/assets/*.gltf
!data/sample/*.glb


# =========================================================
# IDE / Editors
# =========================================================

.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db


# =========================================================
# Logs
# =========================================================

*.log
logs/


# =========================================================
# Docker
# =========================================================

docker-compose.override.yml


# =========================================================
# Temporary files
# =========================================================

*.tmp
*.temp
*.swp
*.swo
*~
